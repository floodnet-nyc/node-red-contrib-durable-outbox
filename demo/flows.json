    {
        "id": "classify-postgres",
        "type": "function",
        "z": "demo-flow",
        "g": "84ef9b0fd4902c58",
        "name": "Classify failure",
        "func": "const permanentCodes = new Set([\n    '22001', '22003', '22P02',\n    '23502', '23503', '23505', '23514',\n    '42601', '42703', '42P01'\n]);\nmsg.outbox.retryable = !permanentCodes.has(msg.error?.code);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
