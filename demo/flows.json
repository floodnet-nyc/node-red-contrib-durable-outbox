        "type": "postgresql",
        "z": "demo-flow",
        "g": "84ef9b0fd4902c58",
        "name": "UPSERT",
        "query": "INSERT INTO sensor_readings (device_id, observed_at, value_mm)\nVALUES ($1, $2, $3)\nON CONFLICT (device_id, observed_at)\nDO UPDATE SET value_mm = EXCLUDED.value_mm\nRETURNING *",
