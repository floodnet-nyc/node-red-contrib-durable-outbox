    {
        "id": "build-outbox-job",
        "type": "function",
        "z": "demo-flow",
        "name": "Build durable PostgreSQL job",
        "func": "const observedAt = new Date();\nconst sequence = context.get('sequence') || 0;\ncontext.set('sequence', sequence + 1);\nconst reading = {\n    device_id: 'demo-sensor-1',\n    observed_at: observedAt.toISOString(),\n    value_mm: 100 + (sequence % 50)\n};\nmsg.payload = reading;\nmsg.outboxJob = {\n    dedupeKey: `reading:${reading.device_id}:${reading.observed_at}`\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 140,
        "wires": [
            [
                "enqueue-postgres",
                "generated-debug"
            ]
        ]
    },
