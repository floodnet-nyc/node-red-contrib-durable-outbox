        "type": "function",
        "z": "22a07776c86a0b11",
        "g": "a3480cccedef34ed",
        "name": "Generate",
        "func": "const observedAt = new Date();\nconst sequence = context.get('sequence') || 0;\ncontext.set('sequence', sequence + 1);\nconst reading = {\n    device_id: 'demo-sensor-1',\n    observed_at: observedAt.toISOString(),\n    value_mm: 100 + (sequence % 50)\n};\n\nmsg.payload = {\n    query: `\nINSERT INTO sensor_readings (device_id, observed_at, value_mm)\nVALUES ($1, $2, $3)\nON CONFLICT (device_id, observed_at)\nDO UPDATE SET value_mm = EXCLUDED.value_mm\nRETURNING *`,\n    params: [\n        reading.device_id, \n        reading.observed_at,\n        reading.value_mm,\n    ]\n}\nmsg.outbox = {\n    dedupeKey: `reading:${reading.device_id}:${reading.observed_at}`\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
