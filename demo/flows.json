        "name": "Batch UPSERT",
        "query": "INSERT INTO sensor_readings (device_id, observed_at, value_mm)\n  SELECT * \n  FROM unnest(\n    $1::text[], \n    $2::timestamptz[], \n    $3::float8[]\n  )\nON CONFLICT (device_id, observed_at)\nDO UPDATE SET value_mm = EXCLUDED.value_mm\nRETURNING *",
