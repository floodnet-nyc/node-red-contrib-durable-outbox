[
  {
    "id": "demo-flow",
    "type": "tab",
    "label": "Durable PostgreSQL outbox demo",
    "disabled": false,
    "info": "Generated readings are committed to SQLite before a worker attempts PostgreSQL delivery."
  },
  {
    "id": "outbox-config",
    "type": "durable-outbox-config",
    "name": "Demo outbox",
    "filename": "/data/outbox/outbox.sqlite",
    "circuitBreakerThreshold": 3,
    "circuitBreakerCooldownMs": 30000,
    "maxQueuedJobs": 100000,
    "maxJobBytes": 1048576,
    "maxEnqueueBatch": 1000,
    "maxDatabaseBytes": 1073741824
  },
  {
    "id": "postgres-config",
    "type": "postgreSQLConfig",
    "name": "Demo PostgreSQL pool",
    "host": "POSTGRES_HOST",
    "hostFieldType": "env",
    "port": "POSTGRES_PORT",
    "portFieldType": "env",
    "database": "POSTGRES_DB",
    "databaseFieldType": "env",
    "ssl": "false",
    "sslFieldType": "bool",
    "applicationName": "durable-outbox-demo",
    "applicationNameType": "str",
    "max": "5",
    "maxFieldType": "num",
    "idle": 1000,
    "idleFieldType": "num",
    "connectionTimeout": 2000,
    "connectionTimeoutFieldType": "num",
    "user": "POSTGRES_USER",
    "userFieldType": "env",
    "password": "POSTGRES_PASSWORD",
    "passwordFieldType": "env"
  },
  {
    "id": "generate-reading",
    "type": "inject",
    "z": "demo-flow",
    "name": "Generate reading every 2s",
    "props": [],
    "repeat": "2",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "x": 160,
    "y": 100,
    "wires": [
      [
        "build-outbox-job"
      ]
    ]
  },
  {
    "id": "build-outbox-job",
    "type": "function",
    "z": "demo-flow",
    "name": "Build durable PostgreSQL job",
    "func": "const observedAt = new Date();\nconst sequence = context.get('sequence') || 0;\ncontext.set('sequence', sequence + 1);\nconst reading = {\n    device_id: 'demo-sensor-1',\n    observed_at: observedAt.toISOString(),\n    value_mm: 100 + (sequence % 50)\n};\nmsg.outboxJobs = {\n    sink: 'postgres-demo',\n    dedupeKey: `reading:${reading.device_id}:${reading.observed_at}`,\n    payload: reading,\n    retryUntilExpired: true,\n    maxAttempts: 8,\n    maxAgeMs: 7 * 24 * 60 * 60 * 1000,\n    baseDelayMs: 1000,\n    maxDelayMs: 5 * 60 * 1000\n};\nmsg.payload = reading;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 100,
    "wires": [
      [
        "enqueue-postgres",
        "generated-debug"
      ]
    ]
  },
  {
    "id": "enqueue-postgres",
    "type": "outbox-enqueue",
    "z": "demo-flow",
    "name": "Commit to local outbox",
    "outbox": "outbox-config",
    "jobProperty": "outboxJobs",
    "x": 700,
    "y": 100,
    "wires": [
      [
        "queued-debug"
      ]
    ]
  },
  {
    "id": "generated-debug",
    "type": "debug",
    "z": "demo-flow",
    "name": "Generated",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 690,
    "y": 40,
    "wires": []
  },
  {
    "id": "queued-debug",
    "type": "debug",
    "z": "demo-flow",
    "name": "Durably queued",
    "active": false,
    "tosidebar": false,
    "console": false,
    "tostatus": true,
    "complete": "outboxEnqueue",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 930,
    "y": 100,
    "wires": []
  },
  {
    "id": "manual-claim",
    "type": "inject",
    "z": "demo-flow",
    "name": "Manual worker poll",
    "props": [],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "x": 150,
    "y": 240,
    "wires": [
      [
        "claim-postgres"
      ]
    ]
  },
  {
    "id": "claim-postgres",
    "type": "outbox-claim",
    "z": "demo-flow",
    "name": "Lease PostgreSQL work",
    "outbox": "outbox-config",
    "sink": "postgres-demo",
    "intervalMs": 500,
    "leaseMs": 15000,
    "maxInFlight": 5,
    "batchSize": 5,
    "x": 420,
    "y": 240,
    "wires": [
      [
        "prepare-postgres-query"
      ]
    ]
  },
  {
    "id": "prepare-postgres-query",
    "type": "function",
    "z": "demo-flow",
    "name": "query",
    "func": "const reading = msg.payload;\nmsg.query = `\n    INSERT INTO sensor_readings (device_id, observed_at, value_mm)\n    VALUES ($1, $2, $3)\n    ON CONFLICT (device_id, observed_at)\n    DO UPDATE SET value_mm = EXCLUDED.value_mm\n    RETURNING *\n`;\nmsg.params = [\n    reading.device_id,\n    reading.observed_at,\n    reading.value_mm\n];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 690,
    "y": 240,
    "wires": [
      [
        "postgres-upsert"
      ]
    ]
  },
  {
    "id": "postgres-upsert",
    "type": "postgresql",
    "z": "demo-flow",
    "name": "Pooled PostgreSQL upsert",
    "query": "",
    "postgreSQLConfig": "postgres-config",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 930,
    "y": 240,
    "wires": [
      [
        "settle-success"
      ]
    ]
  },
  {
    "id": "settle-success",
    "type": "outbox-settle",
    "z": "demo-flow",
    "name": "Acknowledge delivery",
    "outbox": "outbox-config",
    "outcome": "success",
    "x": 1190,
    "y": 240,
    "wires": [
      [
        "delivered-debug"
      ],
      []
    ]
  },
  {
    "id": "postgres-catch",
    "type": "catch",
    "z": "demo-flow",
    "name": "PostgreSQL failure",
    "scope": [
      "postgres-upsert"
    ],
    "uncaught": false,
    "x": 420,
    "y": 340,
    "wires": [
      [
        "classify-postgres"
      ]
    ]
  },
  {
    "id": "classify-postgres",
    "type": "function",
    "z": "demo-flow",
    "name": "Classify PostgreSQL failure",
    "func": "const permanentCodes = new Set([\n    '22001', '22003', '22P02',\n    '23502', '23503', '23505', '23514',\n    '42601', '42703', '42P01'\n]);\nconst code = msg.error?.code;\nconst permanent = permanentCodes.has(code);\nmsg.outboxOutcome = 'failure';\nmsg.outboxRetryable = !permanent;\nmsg.outboxFailureClass = permanent ? 'data' : 'infrastructure';\nmsg.outboxError = msg.error || `PostgreSQL delivery failed (${code || 'unknown'})`;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 340,
    "wires": [
      [
        "settle-failure"
      ]
    ]
  },
  {
    "id": "settle-failure",
    "type": "outbox-settle",
    "z": "demo-flow",
    "name": "Retry or dead-letter",
    "outbox": "outbox-config",
    "outcome": "msg",
    "x": 950,
    "y": 340,
    "wires": [
      [
        "retry-debug"
      ],
      [
        "dead-debug"
      ]
    ]
  },
